{
	"groups": {
		"group:admin": ["{{ default_username }}@"]
	},
	"tagOwners": {
		"tag:server": ["group:admin"]
	},
	"acls": [
		{
			"action": "accept",
			"src": ["autogroup:member"],
			"dst": ["autogroup:tagged:*"]
		},
		{
			"action": "accept",
			"src": ["autogroup:member"],
			"dst": ["autogroup:self:*"]
		},
		{
			"action": "accept",
			"src": ["tag:server"],
			"dst": ["tag:server:*"]
		}
	]
}
