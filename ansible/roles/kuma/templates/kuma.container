[Unit]
Description=Uptime Kuma monitoring
After=network.target

[Container]
Image=docker.io/louislam/uptime-kuma:{{ kuma_version }}
ContainerName=kuma
PublishPort=3001:3001
Volume=/var/lib/kuma:/app/data

[Service]
Restart=always
TimeoutStartSec=600

[Install]
# Start by default on boot
WantedBy=default.target
